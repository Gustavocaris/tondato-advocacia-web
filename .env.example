# URL pública do site (usada nas meta tags Open Graph e no JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.adv.br

# Código de verificação do Google Search Console (só o valor de "content" da meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity.io — artigos do blog. Sem o projectId, o site usa os posts de src/data/posts.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=2ousxa3t
NEXT_PUBLIC_SANITY_DATASET=production
# Segredo do webhook do Sanity que atualiza o site ao publicar (src/app/api/revalidate)
SANITY_REVALIDATE_SECRET=

# Formulário de contato (envio via Resend — https://resend.com)
RESEND_API_KEY=
# Destinatário (padrão: e-mail do escritório em src/lib/site.ts)
# CONTATO_TO=
# Remetente; exige domínio verificado no Resend (padrão: onboarding@resend.dev)
# CONTATO_FROM="Site Tondato <contato@seudominio.adv.br>"
